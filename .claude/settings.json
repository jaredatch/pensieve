{
  "hooks": {
    "FileChanged": [
      {
        "matcher": "project.yml",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && xcodegen generate 2>&1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git -c:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git clean -f:*)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
