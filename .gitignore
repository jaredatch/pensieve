# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
webeditor/node_modules/

# macOS
.DS_Store

# ExecPlan review scratch (untracked by convention)
tmp/

# Local agent/harness state (tracked settings and skills remain shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Superset local scratch
.superset/

# LLVM coverage profiles (regenerated by the test suite)
*.profraw

# Signing and release secrets
*.p12
*.p8
*.cer
*.provisionprofile
.env
.env.*
*ed25519*
# on-disk archives of closed plans (playbook EVO-52) and personal files — never tracked
/archive/
private/

# Python bytecode caches
__pycache__/

/.claude/commands
