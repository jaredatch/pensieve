paths = script/ .github/workflows/ci.yml .gitignore .test-count CONTRIBUTING.md docs/
risk = script/public_hygiene.py
behavior = none
check.gone = run bash -c 'for p in script/ratchet.sh script/ratchet.conf script/ci-replay.sh script/install-hooks.sh script/hooks script/refreeze.sh script/acceptance-extract.awk script/briefing-lint.sh script/tmp-tidy.sh script/drive-stage.sh script/herdr.conf script/console-wake.sh script/gh-attach.sh .test-count docs/test-allowlist.md; do [ ! -e "$p" ] || { echo "$p remains"; exit 1; }; done && test -s .github/workflows/ci.yml && ! grep -nE "Replay commit guards|ci-replay\.sh|RATCHET_|\.test-count" .github/workflows/ci.yml && grep -q "Compute replay range" .github/workflows/ci.yml'
check.docs = run bash -c 'for f in docs/TESTING.md docs/CONVENTIONS.md docs/HOW-PENSIEVE-IS-BUILT.md docs/GLOSSARY.md docs/ARCHITECTURE.md CONTRIBUTING.md .gitignore script/test.sh script/public_hygiene.py script/hygiene_self_test.py script/workflow_self_test.rb; do test -s "$f" || { echo "$f missing or empty"; exit 1; }; done && ! grep -niE "execplan([^-]|$)|ratchet|\.test-count|refreeze|ci-replay|install-hooks|drive-stage|tmp-tidy|briefing-lint|acceptance-extract|herdr|playbook" docs/TESTING.md docs/CONVENTIONS.md docs/HOW-PENSIEVE-IS-BUILT.md docs/GLOSSARY.md docs/ARCHITECTURE.md CONTRIBUTING.md .gitignore && ! grep -nE "Planner|Executor" docs/TESTING.md docs/CONVENTIONS.md docs/HOW-PENSIEVE-IS-BUILT.md docs/GLOSSARY.md docs/ARCHITECTURE.md CONTRIBUTING.md && ! grep -niE "ratchet|playbook" script/test.sh && ! grep -nE "KIT|herdr|ratchet|RATCHET|ci-replay|install-hooks|refreeze|tmp-tidy|drive-stage|briefing-lint|acceptance-extract|script/hooks|\.test-count|Replay commit guards" script/public_hygiene.py script/hygiene_self_test.py script/workflow_self_test.rb && grep -q kramer-bot docs/HOW-PENSIEVE-IS-BUILT.md && grep -q Slipway docs/HOW-PENSIEVE-IS-BUILT.md && grep -q kramer-bot CONTRIBUTING.md'
check.workflow = run bash -c '! grep -q "Replay commit guards" .github/workflows/ci.yml && ruby script/workflow_self_test.rb'
check.wrapper = run bash -c '! grep -qiE "ratchet|playbook" script/test.sh && ./script/test.sh --self-test'
check.hygiene_self = run bash -c '! grep -qE "KIT|herdr|RATCHET" script/public_hygiene.py && ./script/public-hygiene.sh --self-test'
check.hygiene_tree = run bash -c '[ ! -e script/ratchet.conf ] && [ ! -e script/herdr.conf ] && ! grep -qE "KIT|herdr|RATCHET" script/public_hygiene.py && ./script/public-hygiene.sh --tree'
mutation.gone = .slipway/mutations/gone.patch
mutation.docs = .slipway/mutations/docs.patch
mutation.workflow = .slipway/mutations/workflow.patch
mutation.wrapper = .slipway/mutations/wrapper.patch
mutation.hygiene_self = .slipway/mutations/hygiene_self.patch
mutation.hygiene_tree = .slipway/mutations/hygiene_tree.patch
